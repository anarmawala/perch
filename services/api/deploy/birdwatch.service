# systemd unit to run Bird Watch always-on on the NUC.
# Install:
#   sudo cp deploy/birdwatch.service /etc/systemd/system/birdwatch.service
#   sudo nano /etc/systemd/system/birdwatch.service     # set User + WorkingDirectory + env
#   sudo systemctl daemon-reload && sudo systemctl enable --now birdwatch
#   systemctl status birdwatch      journalctl -u birdwatch -f

[Unit]
Description=Bird Watch X-Ray
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/bird_watch/prototype
# --- config (edit these) ---
Environment=STREAM_URL=https://www.youtube.com/watch?v=y9t1g8Ike6g
Environment=NTFY_TOPIC=CHANGE_ME_topic
Environment=PUBLIC_URL=http://CHANGE_ME_nuc_ip:8000/timeline
Environment=EBIRD_API_KEY=
Environment=EBIRD_REGION=US-PA
# --- perf (tune after benchmarking on the NUC) ---
Environment=DETECT_INTERVAL=0.5
Environment=INFER_THREADS=3
Environment=YOLO_IMGSZ=960
# Environment=YOLO_MODEL=yolov8s_openvino_model
ExecStart=/home/CHANGE_ME/bird_watch/prototype/.venv-ml/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
