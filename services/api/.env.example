# Copy to .env and edit. All optional — sensible defaults apply.

# Video source (YouTube live URL now; your camera's rtsp:// URL later)
STREAM_URL=https://www.youtube.com/watch?v=y9t1g8Ike6g

# Notifications (ntfy). Subscribe to this topic in the ntfy phone app.
NTFY_TOPIC=
# PUBLIC_URL makes tapping a push open the timeline:
PUBLIC_URL=http://REPLACE_WITH_SERVER_IP:8000/timeline

# Species accuracy: eBird key (ebird.org/api/keygen) + your region/county code
EBIRD_API_KEY=
EBIRD_REGION=US-PA

# Performance (tune by watching detect_ms on the live page)
DETECT_INTERVAL=0.5
INFER_THREADS=3
YOLO_IMGSZ=960
